# Base URL of the EcoOps Express backend (no trailing slash).
# Leave empty to start in demo-fixture mode.
VITE_API_BASE_URL=http://localhost:5000

# Optional: demo user IDs seeded by the backend, sent as userId on complaints.
VITE_DEMO_STUDENT_ID=
VITE_DEMO_STAFF_ID=
VITE_DEMO_ADMIN_ID=

# Never put Gemini / LLM API keys here. Anything prefixed VITE_ is shipped to the browser.
